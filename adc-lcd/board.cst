// Tang Nano 9K — AD7606 SPI (J6) + ST7789 1.14" (8P). LVCMOS33.
// LCD pins: Sipeed spi_lcd CST. ADC pins: plan 2026-08-25_1239.
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33;

IO_LOC  "btn0_n" 3;
IO_PORT "btn0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "btn1_n" 4;
IO_PORT "btn1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "adc_convst" 25;
IO_PORT "adc_convst" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "adc_convstb" 31;
IO_PORT "adc_convstb" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "adc_reset" 26;
IO_PORT "adc_reset" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "adc_cs" 27;
IO_PORT "adc_cs" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "adc_sclk" 28;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 DRIVE=24;
IO_LOC  "adc_busy" 29;
IO_PORT "adc_busy" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "adc_dout" 30;
IO_PORT "adc_dout" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "i2c_scl" 33;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "i2c_sda" 34;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "lcd_data" 77;
IO_PORT "lcd_data" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_rs" 49;
IO_PORT "lcd_rs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_cs" 48;
IO_PORT "lcd_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_clk" 76;
IO_PORT "lcd_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "lcd_resetn" 47;
IO_PORT "lcd_resetn" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "led" 11;
IO_PORT "led" IO_TYPE=LVCMOS33;
